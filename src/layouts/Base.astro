---
import '../styles/global.css';
import datos from '../../proyectos.json';

const { titulo, descripcion, conLateral = true, esquemaExtra = [] } = Astro.props;
const p = datos.perfil;
const base = import.meta.env.BASE_URL;

// Las redes sociales y los buscadores exigen URLs absolutas.
const urlCanonica = new URL(Astro.url.pathname, Astro.site).href;
const imagenSocial = new URL('img/og.jpg', Astro.site).href;
const retrato = new URL('img/florin-emanuel-todor-gliga.jpg', Astro.site).href;
const esPortada = Astro.url.pathname === '/';

const ID_PERSONA = 'https://florintodor.dev/#persona';
const ID_SITIO = 'https://florintodor.dev/#sitio';

// Schema.org: es lo que permite a Google entender que este sitio es "sobre"
// Florin, y lo que alimenta el panel de conocimiento al buscar su nombre.
// El nombre oficial va sin tilde (como en el DNI, LinkedIn y GitHub); la grafía
// castellanizada "Florín" y los nombres cortos se declaran como alternativos
// para que todas las formas lleven a la misma persona en vez de repartirse.
const persona = {
  '@type': 'Person',
  '@id': ID_PERSONA,
  name: 'Florin Emanuel Todor Gliga',
  givenName: 'Florin',
  additionalName: 'Emanuel',
  familyName: 'Todor Gliga',
  alternateName: [
    'Florín Emanuel Todor Gliga',
    'Florin E. Todor Gliga',
    'Florin Todor Gliga',
    'Florin Todor',
    'Florín Todor',
    'Florin Emanuel Todor',
  ],
  url: 'https://florintodor.dev',
  mainEntityOfPage: { '@id': ID_SITIO },
  image: retrato,
  email: `mailto:${p.email}`,
  jobTitle: 'Ingeniero Informático',
  description:
    'Ingeniero informático especializado en administración de sistemas Linux, ciberseguridad e inteligencia artificial aplicada.',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Motril',
    addressRegion: 'Granada',
    addressCountry: 'ES',
  },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Universidad de Granada',
    sameAs: 'https://www.ugr.es/',
  },
  knowsLanguage: ['es', 'en'],
  knowsAbout: [
    'Linux', 'Docker', 'Ciberseguridad', 'ModSecurity', 'OWASP', 'Nginx', 'HAProxy',
    'Inteligencia artificial generativa', 'Neo4j', 'Grafos de conocimiento',
    'ENS', 'NIS2', 'DORA', 'Python', 'C++',
  ],
  sameAs: [p.github, p.linkedin],
};

const sitio = {
  '@type': 'WebSite',
  '@id': ID_SITIO,
  url: 'https://florintodor.dev',
  name: 'Florin Emanuel Todor Gliga',
  alternateName: 'Florin Todor',
  inLanguage: 'es-ES',
  publisher: { '@id': ID_PERSONA },
};

// La portada es una ficha de perfil: marcarla como tal le dice a Google de quién
// habla la página, no sólo que existe una persona con estos datos.
const pagina = {
  '@type': esPortada ? 'ProfilePage' : 'WebPage',
  '@id': `${urlCanonica}#pagina`,
  url: urlCanonica,
  name: titulo,
  description: descripcion,
  inLanguage: 'es-ES',
  isPartOf: { '@id': ID_SITIO },
  ...(esPortada ? { mainEntity: { '@id': ID_PERSONA } } : { about: { '@id': ID_PERSONA } }),
};

const datosEstructurados = {
  '@context': 'https://schema.org',
  '@graph': [persona, sitio, pagina, ...esquemaExtra],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta name="author" content={p.nombre} />
    <link rel="canonical" href={urlCanonica} />
    <link rel="alternate" type="application/rss+xml" title="Blog de Florin Todor" href={new URL('rss.xml', Astro.site).href} />
    <meta name="robots" content="index, follow, max-image-preview:large" />

    <meta property="og:site_name" content="Florin Emanuel Todor Gliga" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={urlCanonica} />
    <meta property="og:image" content={imagenSocial} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Florin Emanuel Todor Gliga — sistemas Linux, ciberseguridad e IA aplicada" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={imagenSocial} />
    <meta name="twitter:image:alt" content="Florin Emanuel Todor Gliga — sistemas Linux, ciberseguridad e IA aplicada" />

    <script type="application/ld+json" set:html={JSON.stringify(datosEstructurados)} />
    <meta name="theme-color" content="#02162b" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='88'>◆</text></svg>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>

  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>

    <header class="cabecera">
      <div class="cabecera-caja">
        <a class="marca" href={base}>Florin <span>Todor</span></a>
        <nav id="menu">
          <a href={`${base}#sobre-mi`}>Sobre mí</a>
          <a href={`${base}#proyectos`}>Proyectos</a>
          <a href={`${base}blog/`}>Blog</a>
          <a href={`${base}#competencias`}>Competencias</a>
          <a href={`${base}#formacion`}>Formación</a>
          <a href={`${base}certificaciones/`}>Certificaciones</a>
          <a href={`${base}#cv`}>CV</a>
          <a href={`${base}#contacto`}>Contacto</a>
        </nav>
        <button class="menu-movil" id="abrir-menu" aria-label="Abrir menú" aria-expanded="false" aria-controls="menu">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </button>
        <a class="boton" href={`${base}${p.cv}`} download>
          Descargar CV
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
            <path d="M12 3v13m0 0l-5-5m5 5l5-5M4 21h16" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </header>

    <div class={`disposicion${conLateral ? '' : ' sin-lateral'}`}>
      {conLateral && (
        <aside class="lateral">
          <img class="retrato" src={`${base}img/florin-emanuel-todor-gliga.jpg`} alt={`Retrato de ${p.nombre}`} width="172" height="172" />
          <div class="nombre">Florin Emanuel<br />Todor Gliga</div>
          <div class="rol">{p.rol}</div>

          <hr class="punteado" />

          <div class="sociales">
            <a href={p.github} target="_blank" rel="noopener" aria-label="GitHub" title="GitHub">
              <svg viewBox="0 0 24 24"><path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.4-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.1.1 1.7 1.2 1.7 1.2 1 1.8 2.7 1.3 3.4 1 .1-.7.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11 11 0 0 1 6 0C17.6 4.8 18.6 5 18.6 5c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .4.2.7.8.6 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5z"/></svg>
            </a>
            <a href={p.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn" title="LinkedIn">
              <svg viewBox="0 0 24 24"><path d="M20.4 20.4h-3.6v-5.6c0-1.3 0-3-1.9-3s-2.1 1.4-2.1 2.9v5.7H9.3V9h3.4v1.6h.1a3.8 3.8 0 0 1 3.4-1.9c3.6 0 4.3 2.4 4.3 5.5v6.2zM5.3 7.4a2.1 2.1 0 1 1 0-4.2 2.1 2.1 0 0 1 0 4.2zM7.1 20.4H3.5V9h3.6v11.4zM22.2 0H1.8C.8 0 0 .8 0 1.7v20.6c0 .9.8 1.7 1.8 1.7h20.4c1 0 1.8-.8 1.8-1.7V1.7c0-.9-.8-1.7-1.8-1.7z"/></svg>
            </a>
            <a href={`mailto:${p.email}`} aria-label="Correo" title="Correo">
              <svg viewBox="0 0 24 24"><path d="M22 4H2a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h20a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm-.5 2L12 12.3 2.5 6h19zM2 18V7.4l9.5 6.3a1 1 0 0 0 1 0L22 7.4V18H2z"/></svg>
            </a>
          </div>

          <hr class="punteado" />

          <dl class="datos">
            <div><dt>Residencia</dt><dd>España</dd></div>
            <div><dt>Ciudad</dt><dd>{p.ciudad}</dd></div>
            <div><dt>Titulación</dt><dd>Doble Grado<br />Informática + ADE</dd></div>
            <div><dt>Idiomas</dt><dd>Español · Inglés</dd></div>
          </dl>

          <hr class="punteado" />

          <a class="boton" style="width:100%;justify-content:center" href={`mailto:${p.email}`}>
            Contactar
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M22 4H2a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h20a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm-.5 2L12 12.3 2.5 6h19zM2 18V7.4l9.5 6.3a1 1 0 0 0 1 0L22 7.4V18H2z"/></svg>
          </a>
        </aside>
      )}

      <main class="contenido" id="contenido">
        <slot />
      </main>
    </div>

    <footer class="pie-pagina">
      <div class="envoltorio">
        <p>
          © 2026 Florin Emanuel Todor Gliga · {p.ciudad} ·
          <a href={`mailto:${p.email}`}>{p.email}</a>
        </p>
        <p>Hecho con Astro y publicado en GitHub Pages.</p>
      </div>
    </footer>
    <script is:inline>
      // Menú desplegable en pantallas estrechas.
      const boton = document.getElementById('abrir-menu');
      const menu = document.getElementById('menu');
      const alternar = (abierto) => {
        menu.classList.toggle('abierto', abierto);
        boton.setAttribute('aria-expanded', String(abierto));
      };
      boton.addEventListener('click', () => alternar(!menu.classList.contains('abierto')));
      // Al pulsar un enlace se cierra, o el destino queda tapado por el propio menú.
      menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => alternar(false)));
      document.addEventListener('click', (e) => {
        if (menu.classList.contains('abierto') && !menu.contains(e.target) && !boton.contains(e.target)) alternar(false);
      });
      document.addEventListener('keydown', (e) => e.key === 'Escape' && alternar(false));
    </script>
  </body>
</html>
