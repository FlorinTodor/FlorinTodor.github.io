---
import Base from '../../layouts/Base.astro';
import DemoGrafo from '../../components/DemoGrafo.astro';
import DemoBanca from '../../components/DemoBanca.astro';
import datos from '../../../proyectos.json';
import { datosVideo, duracionIso } from '../../utilidades/videos.js';
import { hayVideo as tieneVideo, buscarGif, DEMOS_INTERACTIVAS } from '../../utilidades/demos.js';

export function getStaticPaths() {
  // No generan página los ocultos ni los marcados "NO PUBLICAR".
  return datos.proyectos
    .filter((p) => !p.oculto && !(p.pendiente || []).some((x) => x.startsWith('NO PUBLICAR')))
    .map((p) => ({ params: { id: p.id }, props: { p } }));
}

const { p } = Astro.props;
const base = import.meta.env.BASE_URL;

const hayVideo = tieneVideo(p.id);
const gif = buscarGif(p.id);

const conDemo = DEMOS_INTERACTIVAS.includes(p.id);
const hayDemo = hayVideo || !!gif || conDemo;
const url = new URL(Astro.url.pathname, Astro.site).href;

// Enlaces de la cabecera, de más a menos fuerte: el primero se pinta en verde.
// En los proyectos con el repositorio privado manda la memoria, y si tampoco la
// hay, la demo; el correo queda siempre el último.
const acciones = [
  ...(!p.privado ? [{ href: p.repo, texto: 'Ver el código en GitHub ↗', externo: true }] : []),
  ...(p.memoria ? [{ href: `${base}${p.memoria}`, texto: 'Memoria en PDF ↗', externo: true }] : []),
  ...(hayDemo ? [{ href: '#demo', texto: '▶ Ver la demo' }] : []),
  ...(p.privado ? [{ href: `mailto:${datos.perfil.email}`, texto: 'Código privado: escríbeme' }] : []),
];

// Duración, tamaño y fecha salen del propio MP4 al compilar: no hay nada que
// regenerar a mano cuando se cambia un vídeo.
const video = hayVideo ? datosVideo(p.id) : null;

// Cada proyecto es una obra con autor: refuerza la autoría a nombre completo.
const esquema = [{
  '@type': 'SoftwareSourceCode',
  '@id': `${url}#proyecto`,
  name: p.titulo,
  description: p.resumen,
  inLanguage: 'es-ES',
  ...(p.anio ? { dateCreated: String(p.anio) } : {}),
  ...(p.stack?.length ? { programmingLanguage: p.stack } : {}),
  ...(p.repo && !p.privado ? { codeRepository: p.repo } : {}),
  author: { '@id': 'https://florintodor.dev/#persona' },
}];

// La memoria es una obra en sí misma: declararla como Thesis hace que Google
// la trate como documento académico y no como un PDF suelto del sitio.
if (p.memoria) {
  esquema.push({
    '@type': 'Thesis',
    '@id': `${url}#memoria`,
    name: p.titulo,
    description: p.resumen,
    inLanguage: 'es-ES',
    learningResourceType: 'Trabajo de Fin de Grado',
    ...(p.anio ? { datePublished: String(p.anio) } : {}),
    ...(p.memoriaPaginas ? { numberOfPages: p.memoriaPaginas } : {}),
    url: new URL(p.memoria, Astro.site).href,
    encodingFormat: 'application/pdf',
    author: { '@id': 'https://florintodor.dev/#persona' },
    publisher: { '@type': 'CollegeOrUniversity', name: 'Universidad de Granada' },
    about: { '@id': `${url}#proyecto` },
  });
}

// Sin VideoObject, Google no sabe que la demo existe: no la indexa ni la
// enseña como resultado de vídeo, aunque el <video> esté en la página.
if (video) {
  esquema.push({
    '@type': 'VideoObject',
    '@id': `${url}#video`,
    name: `Demostración de ${p.titulo}`,
    description: p.resumen,
    thumbnailUrl: new URL(`media/poster/${p.id}.jpg`, Astro.site).href,
    contentUrl: new URL(`media/${p.id}.mp4`, Astro.site).href,
    uploadDate: video.fecha,
    duration: duracionIso(video.segundos),
    width: video.ancho,
    height: video.alto,
    inLanguage: 'es-ES',
    isFamilyFriendly: true,
    creator: { '@id': 'https://florintodor.dev/#persona' },
  });
}
---

<Base
  titulo={`${p.titulo} — Florin Todor`}
  descripcion={p.resumen}
  conLateral={false}
  esquemaExtra={esquema}
>
  <div style="max-width:1080px;margin:0 auto">
    <a class="volver" href={`${base}#proyectos`}>← Todos los proyectos</a>

    <header class="cabecera-proyecto">
      <h1>{p.titulo}</h1>
      <div class="meta">
        <span class="etiqueta verde">{p.anio}</span>
        {p.categorias.map((c) => <span class="etiqueta">{c}</span>)}
        {p.privado && <span class="etiqueta ambar">Código privado</span>}
      </div>
      <p class="resumen">{p.resumen}</p>

      {/* Los enlaces van arriba: quien entra busca el código y la demo, no
          quiere bajar a un panel lateral para encontrarlos. */}
      <div class="acciones-proyecto">
        {acciones.map((a, i) => (
          <a
            class={i === 0 ? 'boton' : 'boton fantasma'}
            href={a.href}
            {...(a.externo ? { target: '_blank', rel: 'noopener' } : {})}
          >{a.texto}</a>
        ))}
      </div>
    </header>

    <div class="columnas-proyecto">
      <div>
        {/* ---------- vídeo ---------- */}
        {(hayVideo || gif) && (
          <section id="demo">
            <div class="titulo-seccion"><h2>Demostración</h2><div class="linea"></div></div>
            <div class="marco-media">
              {hayVideo ? (
                <video
                  src={`${base}media/${p.id}.mp4`}
                  poster={`${base}media/poster/${p.id}.jpg`}
                  controls muted loop playsinline preload="none"></video>
              ) : (
                <img src={gif.replace('/public', base.replace(/\/$/, ''))} alt={`Demostración de ${p.titulo}`} loading="lazy" />
              )}
            </div>
          </section>
        )}

        {/* ---------- demos interactivas ---------- */}
        {p.id === 'ciber-asesoria' && (
          <section id={hayVideo || gif ? undefined : 'demo'}>
            <div class="titulo-seccion"><h2>Explora el grafo normativo</h2><div class="linea"></div></div>
            <p style="color:var(--texto-suave)">
              El núcleo del módulo es un grafo que enlaza los artículos de NIS2 y DORA con los
              controles del ENS que los satisfacen. Elige un artículo y verás qué controles exige.
              Son los datos reales del grafo del TFG.
            </p>
            <DemoGrafo />
          </section>
        )}

        {p.id === 'habla-con-tu-dinero' && (
          <section id={hayVideo || gif ? undefined : 'demo'}>
            <div class="titulo-seccion"><h2>Pruébalo</h2><div class="linea"></div></div>
            <p style="color:var(--texto-suave)">
              Pulsa las preguntas sugeridas para reproducir una conversación: verás las llamadas a
              herramientas del modelo, el SQL que genera y los gráficos que decide dibujar.
            </p>
            <DemoBanca />
          </section>
        )}

        {/* ---------- detalle ---------- */}
        <section>
          <div class="titulo-seccion"><h2>Qué hace</h2><div class="linea"></div></div>
          <ul class="lista">
            {p.destacados.map((d) => <li>{d}</li>)}
          </ul>
        </section>

        {p.autoria && (
          <section>
            <div class="titulo-seccion"><h2>Autoría</h2><div class="linea"></div></div>
            <p style="color:var(--texto-suave)">{p.autoria}</p>
          </section>
        )}
      </div>

      {/* ---------- lateral ---------- */}
      <aside>
        <div class="panel-lateral">
          <h4>Stack</h4>
          <div class="etiquetas">{p.stack.map((t) => <span class="etiqueta">{t}</span>)}</div>
        </div>

        <div class="panel-lateral">
          <h4>Contexto</h4>
          <p style="margin:0;font-size:.89rem;color:var(--texto-suave)">{p.contexto}</p>
        </div>

        {p.memoria && (
          <div class="panel-lateral">
            <h4>Memoria</h4>
            <p style="margin:0 0 .8rem;font-size:.89rem;color:var(--texto-suave)">
              El documento completo{p.memoriaPaginas ? `, ${p.memoriaPaginas} páginas` : ''}:
              planteamiento, diseño del grafo, evaluación y resultados.
            </p>
            <a class="boton fantasma" href={`${base}${p.memoria}`} download>Descargar el PDF</a>
          </div>
        )}

        <div class="panel-lateral">
          <h4>Más</h4>
          <p style="margin:0;font-size:.89rem"><a class="enlace-suelto" href={`${base}#proyectos`}>← Otros proyectos</a></p>
        </div>
      </aside>
    </div>
  </div>
</Base>
