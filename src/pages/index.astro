---
import Base from '../layouts/Base.astro';
import datos from '../../proyectos.json';

const { perfil, proyectos } = datos;
const base = import.meta.env.BASE_URL;

// Sólo mostramos los proyectos que no están marcados como "no publicar".
const publicables = proyectos.filter(
  (p) => !(p.pendiente || []).some((x) => x.startsWith('NO PUBLICAR'))
);
const destacados = publicables.filter((p) => p.destacado);
const resto = publicables.filter((p) => !p.destacado);

const medios = import.meta.glob('/public/media/*.mp4', { eager: true });
const tieneVideo = (id) => Object.keys(medios).some((f) => f.endsWith(`/media/${id}.mp4`));
const conVideo = publicables.filter((p) => tieneVideo(p.id)).length;

const formacion = [
  {
    fecha: '2021 – 2026',
    centro: 'Universidad de Granada',
    titulo: 'Doble Grado en Ingeniería Informática y Administración y Dirección de Empresas',
    detalle:
      'Itinerario orientado a ciberseguridad, administración de sistemas Linux e infraestructura de servidores. TFG sobre evaluación automática de cumplimiento normativo con IA generativa.',
  },
  {
    fecha: '2020 – 2021',
    centro: 'Cisco Networking Academy',
    titulo: 'PCAP: Programming Essentials in Python',
    detalle: 'Certificación oficial. Complementada con el curso Introducción a la Seguridad Cibernética.',
  },
  {
    fecha: '2021 – 2022',
    centro: 'Universidad de Granada',
    titulo: 'MOOC de Conocimiento Abierto y Software Libre · MOOC de Machine Learning y Big Data para Bioinformática',
    detalle: 'Formación complementaria en software libre y en aplicación de aprendizaje automático a datos biomédicos.',
  },
];

const competencias = [
  { area: 'Sistemas e infraestructura', items: ['Linux', 'Bash', 'Docker', 'Docker Compose', 'Nginx', 'HAProxy', 'Traefik', 'Envoy', 'Balanceo de carga', 'Alta disponibilidad'] },
  { area: 'Ciberseguridad', items: ['ModSecurity', 'OWASP CRS', 'IPTABLES', 'HTTPS/SSL (OpenSSL)', 'ENS', 'NIS2', 'DORA', 'PCAP (Cisco)'] },
  { area: 'IA y datos', items: ['IA generativa', 'RAG', 'Grafos de conocimiento', 'Neo4j', 'Ollama', 'LangChain', 'Sentence-BERT', 'Pandas', 'Statsmodels'] },
  { area: 'Lenguajes', items: ['Python', 'C++', 'Java', 'JavaScript', 'Dart', 'Ruby', 'SQL', 'Cypher'] },
  { area: 'Desarrollo web', items: ['Node.js', 'Express', 'FastAPI', 'React', 'Next.js', 'Flutter', 'MongoDB', 'Tailwind'] },
  { area: 'Rendimiento y pruebas', items: ['Apache Benchmark', 'Locust', 'pytest', 'Jest', 'RAGAS'] },
];
---

<Base
  titulo="Florín Todor — Sistemas Linux, Ciberseguridad e IA aplicada"
  descripcion="Portafolio de Florín Emanuel Todor Gliga: infraestructura Linux y Docker, ciberseguridad e IA aplicada. Doble Grado en Informática y ADE por la UGR."
>
  {/* ---------------- Portada ---------------- */}
  <section id="inicio" class="portada">
    <div class="etiqueta-seccion">Inicio</div>
    <h1>Construyo sistemas.<br />Y me aseguro de que <em>aguanten</em>.</h1>
    <p class="entradilla">
      Soy Florín, de Motril. Acabo de terminar el <strong>Doble Grado en Ingeniería
      Informática y ADE</strong> en la Universidad de Granada. Me muevo entre los
      <strong>sistemas Linux</strong>, la <strong>ciberseguridad</strong> y la
      <strong>IA aplicada</strong>, y tengo la manía de medir lo que construyo en vez
      de suponer que funciona.
    </p>
    <div class="acciones">
      <a class="boton" href="#proyectos">Ver proyectos</a>
      <a class="boton fantasma" href={`${base}CV_Florin_Todor.pdf`} download>Descargar CV</a>
      <a class="boton fantasma" href={`mailto:${perfil.email}`}>Escríbeme</a>
    </div>
  </section>

  <div class="cifras">
    <div class="cifra"><strong>{publicables.length}</strong><span>proyectos publicados</span></div>
    <div class="cifra"><strong>{conVideo}</strong><span>con demo en vídeo</span></div>
    <div class="cifra"><strong>8</strong><span>lenguajes de programación</span></div>
    <div class="cifra"><strong>5</strong><span>años de doble grado</span></div>
  </div>

  {/* ---------------- 01 Sobre mí ---------------- */}
  <section id="sobre-mi">
    <div class="titulo-seccion"><h2>Sobre mí</h2><div class="linea"></div><div class="num">01</div></div>
    <div class="tarjeta">
      <p>
        Estudié el <strong>Doble Grado en Ingeniería Informática y ADE</strong>: cinco años
        compaginando compiladores con contabilidad. Suena a mezcla rara y durante un tiempo
        lo pareció, pero acabó siendo lo que más me distingue: entiendo el sistema que hay
        debajo y también por qué a una empresa le importa. Cuando alguien discute si una
        medida de seguridad compensa, puedo hablar del coste en milisegundos y del coste en euros.
      </p>
      <p>
        Donde más cómodo estoy es en <strong>Linux y Docker</strong>. He montado granjas web
        con ocho servidores y cuatro balanceadores distintos, un cortafuegos de aplicación con
        ModSecurity delante de una tienda vulnerable, y HTTPS y cortafuegos perimetrales sobre
        contenedores. También he hecho un e-commerce full-stack, una app móvil en Flutter con
        backend en Rails, un motor de realidad aumentada con OpenCV y unos cuantos programas
        en C++ que no tocan una red en su vida.
      </p>
      <p>
        Mi obsesión, si tengo alguna, es <strong>comprobar las cosas</strong>. Me interesa
        menos que algo funcione en mi máquina que saber cuánto cuesta, cuándo se rompe y cómo
        se demuestra. En el TFG eso significó validar el motor contra la propia normativa en
        lugar de contra sí mismo; en la granja web, medir que HAProxy iba 4,3 veces más rápido
        que Nginx antes de opinar cuál era mejor. Los números que verás en este portafolio los
        he medido yo.
      </p>
      <p style="margin-bottom:0">
        Busco un primer puesto donde seguir en esa frontera entre <strong>sistemas, seguridad
        e inteligencia artificial</strong>. Ahora mismo estoy subiendo el nivel de inglés, que
        es mi asignatura pendiente. Si algo de lo que hay aquí te encaja, escríbeme.
      </p>
    </div>
  </section>

  {/* ---------------- 02 Proyectos ---------------- */}
  <section id="proyectos">
    <div class="titulo-seccion"><h2>Proyectos</h2><div class="linea"></div><div class="num">02</div></div>

    <div class="subtitulo">Destacados</div>
    <div class="rejilla-proyectos">
      {destacados.map((p, i) => (
        <a class={`tarjeta-proyecto ${i === 0 ? 'destacado' : ''}`} href={`${base}proyectos/${p.id}/`}>
          <div class="miniatura">
            {tieneVideo(p.id) ? (
              <>
                <video src={`${base}media/${p.id}.mp4`} muted loop playsinline preload="metadata"></video>
                <span class="insignia-video">▶ demo</span>
              </>
            ) : (
              <div class="sin-video"><span>Sin vídeo todavía</span></div>
            )}
          </div>
          <div class="cuerpo">
            <h3>{p.titulo}</h3>
            <p>{p.resumen}</p>
            <div class="pie">
              {p.privado && <span class="etiqueta ambar">Código privado</span>}
              {p.stack.slice(0, i === 0 ? 6 : 3).map((t) => <span class="etiqueta">{t}</span>)}
            </div>
          </div>
        </a>
      ))}
    </div>

    <div class="subtitulo">Otros trabajos</div>
    <div class="rejilla-proyectos">
      {resto.map((p) => (
        <a class="tarjeta-proyecto" href={`${base}proyectos/${p.id}/`}>
          <div class="miniatura">
            {tieneVideo(p.id) ? (
              <>
                <video src={`${base}media/${p.id}.mp4`} muted loop playsinline preload="metadata"></video>
                <span class="insignia-video">▶ demo</span>
              </>
            ) : (
              <div class="sin-video"><span>Sin vídeo todavía</span></div>
            )}
          </div>
          <div class="cuerpo">
            <h3>{p.titulo}</h3>
            <p>{p.resumen}</p>
            <div class="pie">
              {p.privado && <span class="etiqueta ambar">Código privado</span>}
              {p.stack.slice(0, 3).map((t) => <span class="etiqueta">{t}</span>)}
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  {/* ---------------- 03 Competencias ---------------- */}
  <section id="competencias">
    <div class="titulo-seccion"><h2>Competencias</h2><div class="linea"></div><div class="num">03</div></div>
    {competencias.map((c) => (
      <div class="tarjeta">
        <div style="color:var(--verde);font-weight:700;font-size:.9rem;margin-bottom:.7rem">{c.area}</div>
        <div class="etiquetas">{c.items.map((i) => <span class="etiqueta">{i}</span>)}</div>
      </div>
    ))}
  </section>

  {/* ---------------- 04 Formación ---------------- */}
  <section id="formacion">
    <div class="titulo-seccion"><h2>Formación</h2><div class="linea"></div><div class="num">04</div></div>
    {formacion.map((f) => (
      <div class="tarjeta">
        <span class="pastilla-fecha">{f.fecha}</span>
        <div style="color:var(--texto-tenue);font-size:.84rem">{f.centro}</div>
        <h3 style="font-size:1.02rem;margin:.4rem 0 .6rem">{f.titulo}</h3>
        <p style="color:var(--texto-suave);font-size:.9rem;margin:0">{f.detalle}</p>
      </div>
    ))}
  </section>

  {/* ---------------- 05 CV ---------------- */}
  <section id="cv">
    <div class="titulo-seccion"><h2>Currículum</h2><div class="linea"></div><div class="num">05</div></div>
    <div class="tarjeta">
      <div class="bloque-cv">
        <a class="vista" href={`${base}CV_Florin_Todor.pdf`} target="_blank" rel="noopener">
          <img src={`${base}img/cv-preview-1.png`} alt="Primera página del currículum" loading="lazy" />
        </a>
        <div>
          <h3 style="font-size:1.1rem;margin-bottom:.7rem">Currículum en PDF</h3>
          <p style="color:var(--texto-suave)">
            Una página con la formación, los proyectos y las competencias técnicas.
            Actualizado a agosto de 2026.
          </p>
          <ul class="lista">
            <li>Doble Grado en Ingeniería Informática y ADE (UGR, 2021–2026)</li>
            <li>Certificación PCAP de Cisco</li>
            <li>Proyectos de infraestructura, ciberseguridad e IA generativa</li>
          </ul>
          <div class="acciones">
            <a class="boton" href={`${base}CV_Florin_Todor.pdf`} download>Descargar PDF</a>
            <a class="boton fantasma" href={`${base}CV_Florin_Todor.pdf`} target="_blank" rel="noopener">Abrir en el navegador</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ---------------- 06 Contacto ---------------- */}
  <section id="contacto">
    <div class="titulo-seccion"><h2>Contacto</h2><div class="linea"></div><div class="num">06</div></div>
    <div class="rejilla-contacto">
      <div class="contacto-item">
        <div class="clave">Correo</div>
        <div class="valor"><a href={`mailto:${perfil.email}`}>{perfil.email}</a></div>
      </div>
      <div class="contacto-item">
        <div class="clave">Teléfono</div>
        <div class="valor">{perfil.telefono}</div>
      </div>
      <div class="contacto-item">
        <div class="clave">GitHub</div>
        <div class="valor"><a href={perfil.github} target="_blank" rel="noopener">FlorinTodor</a></div>
      </div>
      <div class="contacto-item">
        <div class="clave">LinkedIn</div>
        <div class="valor"><a href={perfil.linkedin} target="_blank" rel="noopener">florin-emanuel-todor-gliga</a></div>
      </div>
    </div>
  </section>

  <script is:inline>
    // Las miniaturas se reproducen al pasar el ratón; en móvil, al entrar en pantalla.
    const tarjetas = document.querySelectorAll('.tarjeta-proyecto');
    const finoPuntero = matchMedia('(hover: hover)').matches;
    tarjetas.forEach((t) => {
      const v = t.querySelector('video');
      if (!v) return;
      if (finoPuntero) {
        t.addEventListener('mouseenter', () => v.play().catch(() => {}));
        t.addEventListener('mouseleave', () => { v.pause(); v.currentTime = 0; });
      }
    });
    if (!finoPuntero && 'IntersectionObserver' in window) {
      const obs = new IntersectionObserver((es) => {
        es.forEach((e) => {
          const v = e.target.querySelector('video');
          if (!v) return;
          e.isIntersecting ? v.play().catch(() => {}) : v.pause();
        });
      }, { threshold: 0.5 });
      tarjetas.forEach((t) => obs.observe(t));
    }
  </script>
</Base>
