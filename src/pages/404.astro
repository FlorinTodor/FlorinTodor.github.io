---
/**
 * GitHub Pages sirve este mismo fichero para cualquier ruta que no exista,
 * también las de /en/, así que no puede estar en un solo idioma: quien siga un
 * enlace roto en inglés no debería aterrizar en una página en español. Por eso
 * lleva los dos y no anuncia hreflang (`conAlternativas`): no hay dos páginas,
 * hay una.
 */
import Base from '../layouts/Base.astro';
import { t, IDIOMAS } from '../idiomas/textos.js';
import { enlace } from '../idiomas/rutas.js';

const bloques = IDIOMAS.map((idioma) => ({ idioma, E: t(idioma).error404 }));
const es = t('es').error404;
---

<Base
  titulo={es.titulo}
  descripcion={es.descripcion}
  conLateral={false}
  conAlternativas={false}
  sinIndexar
>
  <div style="max-width:820px;margin:0 auto">
    {bloques.map(({ idioma, E }, i) => (
      <section lang={idioma} style={i > 0 ? 'margin-top:3.5rem' : undefined}>
        {i > 0 && <hr class="punteado" style="margin:0 0 2.5rem" />}
        <header class="cabecera-proyecto">
          <div style="color:var(--verde);font-family:var(--mono);font-size:.82rem;text-transform:uppercase;letter-spacing:.12em;margin-bottom:.8rem">
            Error 404
          </div>
          <h1 style={i > 0 ? 'font-size:1.6rem' : undefined}>{E.encabezado}</h1>
          <p class="resumen">{E.resumen}</p>
        </header>

        <div class="rejilla-404">
          {E.destinos.map((d) => (
            <a class="tarjeta destino-404" href={d.camino.startsWith('#') ? `${enlace(idioma)}${d.camino}` : enlace(idioma, d.camino)}>
              <h2>{d.titulo}</h2>
              <p>{d.texto}</p>
            </a>
          ))}
        </div>

        <p style="margin-top:2rem">
          <a class="enlace-suelto" href={enlace(idioma)}>{E.volver}</a>
        </p>
      </section>
    ))}
  </div>
</Base>
