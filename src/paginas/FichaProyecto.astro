---
/**
 * Página de un proyecto, en el idioma que se le pase. Ver src/paginas/Portada.astro
 * para el porqué de tener el cuerpo aquí y una ruta por idioma.
 */
import Base from '../layouts/Base.astro';
import DemoGrafo from '../components/DemoGrafo.astro';
import DemoRutina from '../components/DemoRutina.astro';
import { perfil } from '../idiomas/contenido.js';
import { t, LOCALE } from '../idiomas/textos.js';
import { enlace, recurso } from '../idiomas/rutas.js';
import { datosVideo, duracionIso } from '../utilidades/videos.js';
import { hayVideo as tieneVideo, buscarGif, DEMOS_INTERACTIVAS } from '../utilidades/demos.js';

const { p, idioma = 'es' } = Astro.props;
const T = t(idioma);
const F = T.ficha;

const hayVideo = tieneVideo(p.id);
const gif = buscarGif(p.id);

const conDemo = DEMOS_INTERACTIVAS.includes(p.id);
const hayDemo = hayVideo || !!gif || conDemo;
const url = new URL(Astro.url.pathname, Astro.site).href;

// Un proyecto que está en producción (`web`) enseña su grabación como una
// pantalla de navegador, a mitad de la ficha: después de contar qué hace y
// antes de cómo está hecho. El dominio se escribe tal cual (con su ñ): new
// URL() lo devolvería en punycode.
const dominio = p.web ? p.web.replace(/^https?:\/\//, '').replace(/\/$/, '') : null;
const pantalla = !!p.web && hayVideo;

// Enlaces de la cabecera, de más a menos fuerte: el primero se pinta en verde.
// Manda el prototipo cuando lo hay, porque es lo único que se puede tocar; en
// los proyectos con el repositorio privado manda la memoria, y si tampoco la
// hay, la demo; el correo queda siempre el último.
const acciones = [
  ...(p.web ? [{ href: p.web, texto: F.verWeb(dominio), externo: true }] : []),
  ...(p.prototipo ? [{ href: p.prototipo, texto: F.verPrototipo, externo: true }] : []),
  ...(!p.privado ? [{ href: p.repo, texto: F.verCodigo, externo: true }] : []),
  ...(p.memoria ? [{ href: recurso(p.memoria), texto: F.verMemoria, externo: true }] : []),
  ...(hayDemo && !p.prototipo ? [{ href: '#demo', texto: F.verDemo }] : []),
  ...(p.privado ? [{ href: `mailto:${perfil(idioma).email}`, texto: F.privadoEscribeme }] : []),
];

// Duración, tamaño y fecha salen del propio MP4 al compilar: no hay nada que
// regenerar a mano cuando se cambia un vídeo.
const video = hayVideo ? datosVideo(p.id) : null;

// Cada proyecto es una obra con autor: refuerza la autoría a nombre completo.
// `inLanguage` es el de la página, no el del código ni el de la memoria.
const esquema = [{
  '@type': 'SoftwareSourceCode',
  '@id': `${url}#proyecto`,
  name: p.titulo,
  description: p.resumen,
  inLanguage: LOCALE[idioma],
  ...(p.anio ? { dateCreated: String(p.anio) } : {}),
  ...(p.stack?.length ? { programmingLanguage: p.stack } : {}),
  ...(p.repo && !p.privado ? { codeRepository: p.repo } : {}),
  ...(p.web ? { targetProduct: { '@id': `${url}#web` } } : {}),
  author: { '@id': 'https://florintodor.dev/#persona' },
}];

// La web en producción, como aplicación con autor. La URL va en punycode,
// igual que el canonical de la propia web, para que Google vea que es la misma.
if (p.web) {
  esquema.push({
    '@type': 'WebApplication',
    '@id': `${url}#web`,
    name: p.titulo.split(' - ')[0],
    alternateName: dominio,
    url: new URL(p.web).href,
    description: p.resumen,
    applicationCategory: 'TravelApplication',
    operatingSystem: 'Web',
    isAccessibleForFree: true,
    inLanguage: 'es-ES',
    creator: { '@id': 'https://florintodor.dev/#persona' },
  });
}

// Migas de pan: en los resultados sale "Florin Todor › Radar España" en vez de
// la URL a secas. Sin el paso intermedio de "Proyectos": no tiene página
// propia, y un ancla de la portada sería la misma URL que el primer paso.
esquema.push({
  '@type': 'BreadcrumbList',
  '@id': `${url}#migas`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Florin Todor', item: new URL(enlace(idioma), Astro.site).href },
    { '@type': 'ListItem', position: 2, name: p.titulo.split(' - ')[0], item: url },
  ],
});

// La memoria es una obra en sí misma: declararla como Thesis hace que Google
// la trate como documento académico y no como un PDF suelto del sitio. Está
// escrita en español aunque la ficha se lea en inglés. Una memoria que no es
// de un TFG (la técnica de un reto) dice su tipo en `memoriaTipo`, y entonces
// no lleva ni la etiqueta de TFG ni la universidad como editora.
if (p.memoria) {
  const tfg = !p.memoriaTipo || p.memoriaTipo === 'Thesis';
  esquema.push({
    '@type': tfg ? 'Thesis' : p.memoriaTipo,
    '@id': `${url}#memoria`,
    name: p.titulo,
    description: p.resumen,
    inLanguage: 'es-ES',
    ...(tfg ? { learningResourceType: F.tfg } : {}),
    ...(p.anio ? { datePublished: String(p.anio) } : {}),
    ...(p.memoriaPaginas ? { numberOfPages: p.memoriaPaginas } : {}),
    url: new URL(p.memoria, Astro.site).href,
    encodingFormat: 'application/pdf',
    author: { '@id': 'https://florintodor.dev/#persona' },
    ...(tfg ? { publisher: { '@type': 'CollegeOrUniversity', name: T.universidad } } : {}),
    about: { '@id': `${url}#proyecto` },
  });
}

// Sin VideoObject, Google no sabe que la demo existe: no la indexa ni la
// enseña como resultado de vídeo, aunque el <video> esté en la página. El
// vídeo está grabado en español las dos veces: es la misma grabación.
if (video) {
  esquema.push({
    '@type': 'VideoObject',
    '@id': `${url}#video`,
    name: F.demostracionAlt(p.titulo),
    description: p.resumen,
    thumbnailUrl: new URL(`media/poster/${p.id}.jpg`, Astro.site).href,
    contentUrl: new URL(`media/${p.id}.mp4`, Astro.site).href,
    uploadDate: video.fecha,
    duration: duracionIso(video.segundos),
    width: video.ancho,
    height: video.alto,
    inLanguage: 'es-ES',
    isFamilyFriendly: true,
    creator: { '@id': 'https://florintodor.dev/#persona' },
  });
}
---

<Base
  idioma={idioma}
  titulo={`${p.tituloSeo || p.titulo} - Florin Todor`}
  descripcion={p.descripcionSeo || p.resumen}
  imagenOg={idioma === 'en' ? `img/og/en/${p.id}.jpg` : `img/og/${p.id}.jpg`}
  altOg={F.altOg(p.titulo)}
  conLateral={false}
  esquemaExtra={esquema}
>
  <div style="max-width:1080px;margin:0 auto">
    <a class="volver" href={`${enlace(idioma)}#proyectos`}>{F.volver}</a>

    <header class="cabecera-proyecto">
      <h1>{p.titulo}</h1>
      <div class="meta">
        <span class="etiqueta verde">{p.anio}</span>
        {p.categorias.map((c) => <span class="etiqueta">{c}</span>)}
        {p.privado && <span class="etiqueta ambar">{F.privado}</span>}
      </div>
      <p class="resumen">{p.resumen}</p>

      {p.cifras && (
        <ul class="cifras" aria-label={F.cifras}>
          {p.cifras.map((c) => <li><strong>{c.valor}</strong><span>{c.texto}</span></li>)}
        </ul>
      )}

      {/* Los enlaces van arriba: quien entra busca el código y la demo, no
          quiere bajar a un panel lateral para encontrarlos. */}
      <div class="acciones-proyecto">
        {acciones.map((a, i) => (
          <a
            class={i === 0 ? 'boton' : 'boton fantasma'}
            href={a.href}
            {...(a.externo ? { target: '_blank', rel: 'noopener' } : {})}
          >{a.texto}</a>
        ))}
      </div>
    </header>

    <div class="columnas-proyecto">
      <div>
        {/* ---------- vídeo ----------
            Casi todas las demos son grabaciones de pantalla sin sonido, y van en
            bucle y silenciadas. La que trae audio (una narración, la voz del
            asistente) se oye al darle al play y no se repite. */}
        {(hayVideo || gif) && !pantalla && (
          <section id="demo">
            <div class="titulo-seccion">
              <h2>{p.prototipo ? F.tituloPrototipo : F.demostracion}</h2><div class="linea"></div>
            </div>
            {p.prototipo && <p style="color:var(--texto-suave)">{F.introPrototipo}</p>}
            <div class="marco-media">
              {hayVideo ? (
                <video
                  src={recurso(`media/${p.id}.mp4`)}
                  poster={recurso(`media/poster/${p.id}.jpg`)}
                  controls muted={!video.audio} loop={!video.audio} playsinline preload="none"></video>
              ) : (
                <img
                  src={recurso(gif.replace('/public/', ''))}
                  alt={(p.prototipo ? F.capturasAlt : F.demostracionAlt)(p.titulo)}
                  loading="lazy" />
              )}
            </div>
          </section>
        )}

        {/* ---------- demos interactivas ---------- */}
        {p.id === 'ciber-asesoria' && (
          <section id={hayVideo || gif ? undefined : 'demo'}>
            <div class="titulo-seccion"><h2>{F.tituloGrafo}</h2><div class="linea"></div></div>
            <p style="color:var(--texto-suave)">{F.introGrafo}</p>
            <DemoGrafo idioma={idioma} />
          </section>
        )}

        {p.id === 'rutina-export' && (
          <section id={hayVideo || gif ? undefined : 'demo'}>
            <div class="titulo-seccion"><h2>{F.tituloRutina}</h2><div class="linea"></div></div>
            <p style="color:var(--texto-suave)">{F.introRutina}</p>
            <DemoRutina idioma={idioma} />
          </section>
        )}

        {/* ---------- detalle ---------- */}
        <section>
          <div class="titulo-seccion"><h2>{F.queHace}</h2><div class="linea"></div></div>
          <ul class="lista">
            {p.destacados.map((d) => <li>{d}</li>)}
          </ul>
        </section>

        {/* ---------- la web en producción ----------
            La grabación va dentro de un marco de navegador con su dirección,
            que enlaza a la web de verdad. Se reproduce sola, sin sonido,
            mientras está a la vista (ver el script del final). */}
        {pantalla && (
          <section id="demo">
            <div class="titulo-seccion"><h2>{F.tituloPantalla}</h2><div class="linea"></div></div>
            {p.pantallaTexto && <p style="color:var(--texto-suave)">{p.pantallaTexto}</p>}
            <div class="pantalla">
              <div class="pantalla-barra">
                <span class="puntos" aria-hidden="true"><i></i><i></i><i></i></span>
                <a class="direccion" href={p.web} target="_blank" rel="noopener">
                  <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path fill="currentColor" d="M4 7V5a4 4 0 1 1 8 0v2h.5A1.5 1.5 0 0 1 14 8.5v6a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 2 14.5v-6A1.5 1.5 0 0 1 3.5 7H4Zm2 0h4V5a2 2 0 1 0-4 0v2Z"/></svg>
                  <span>{dominio}</span>
                </a>
              </div>
              <video
                src={recurso(`media/${p.id}.mp4`)}
                poster={recurso(`media/poster/${p.id}.jpg`)}
                aria-label={F.demostracionAlt(p.titulo)}
                controls muted loop playsinline preload="none"></video>
            </div>
          </section>
        )}

        {/* ---------- cómo está hecho ----------
            Tarjetas cortas por tema (seguridad, caché, despliegue...): lo que
            interesa a quien evalúa el trabajo, sin convertir la ficha en el
            README del proyecto. */}
        {p.apartados && (
          <section>
            <div class="titulo-seccion"><h2>{F.comoEsta}</h2><div class="linea"></div></div>
            <div class="rejilla-apartados">
              {p.apartados.map((a) => (
                <div class="apartado">
                  <h3>{a.titulo}</h3>
                  <ul class="lista">{a.puntos.map((x) => <li>{x}</li>)}</ul>
                </div>
              ))}
            </div>
          </section>
        )}

        {p.autoria && (
          <section>
            <div class="titulo-seccion"><h2>{F.autoria}</h2><div class="linea"></div></div>
            <p style="color:var(--texto-suave)">{p.autoria}</p>
          </section>
        )}
      </div>

      {/* ---------- lateral ---------- */}
      <aside>
        <div class="panel-lateral">
          <h3>{F.stack}</h3>
          <div class="etiquetas">{p.stack.map((x) => <span class="etiqueta">{x}</span>)}</div>
        </div>

        <div class="panel-lateral">
          <h3>{F.contexto}</h3>
          <p style="margin:0;font-size:.89rem;color:var(--texto-suave)">{p.contexto}</p>
        </div>

        {p.memoria && (
          <div class="panel-lateral">
            <h3>{F.memoria}</h3>
            <p style="margin:0 0 .8rem;font-size:.89rem;color:var(--texto-suave)">
              {F.memoriaTexto(p.memoriaPaginas, p.memoriaContenido)}
            </p>
            <a class="boton fantasma" href={recurso(p.memoria)} download>{F.descargarMemoria}</a>
          </div>
        )}

        <div class="panel-lateral">
          <h3>{F.mas}</h3>
          <p style="margin:0;font-size:.89rem"><a class="enlace-suelto" href={`${enlace(idioma)}#proyectos`}>{F.otrosProyectos}</a></p>
        </div>
      </aside>
    </div>
  </div>
</Base>

<script>
  // La pantalla de una web en producción se enciende sola cuando se ve y se
  // apaga al salir de la vista, para no gastar datos ni batería de fondo. Con
  // "reducir movimiento" se queda quieta hasta que se le dé al play.
  const video = document.querySelector<HTMLVideoElement>('.pantalla video');
  if (video && 'IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting) video.play().catch(() => {});
      else video.pause();
    }, { threshold: 0.4 }).observe(video);
  }
</script>
