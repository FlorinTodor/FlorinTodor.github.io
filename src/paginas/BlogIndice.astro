---
/**
 * /blog/ y /en/blog/. Ver src/paginas/Portada.astro.
 */
import Base from '../layouts/Base.astro';
import { t, LOCALE } from '../idiomas/textos.js';
import { enlace } from '../idiomas/rutas.js';
import { articulos as listado, slugDe } from '../idiomas/blog.js';

const { idioma = 'es' } = Astro.props;
const T = t(idioma);
const B = T.blog;

const articulos = await listado(idioma);
const fmt = (d) => d.toLocaleDateString(LOCALE[idioma], { day: 'numeric', month: 'long', year: 'numeric' });
const url = new URL(Astro.url.pathname, Astro.site).href;

const esquema = [{
  '@type': 'Blog',
  '@id': `${url}#blog`,
  name: B.encabezado,
  description: B.descripcion,
  inLanguage: LOCALE[idioma],
  author: { '@id': 'https://florintodor.dev/#persona' },
  publisher: { '@id': 'https://florintodor.dev/#persona' },
}];
---

<Base
  idioma={idioma}
  titulo={B.titulo}
  descripcion={B.descripcion}
  conLateral={false}
  esquemaExtra={esquema}
>
  <div style="max-width:820px;margin:0 auto">
    <header class="cabecera-proyecto">
      <div class="etiqueta-seccion" style="color:var(--verde);font-family:var(--mono);font-size:.82rem;text-transform:uppercase;letter-spacing:.12em;margin-bottom:.8rem">{B.antetitulo}</div>
      <h1>{B.encabezado}</h1>
      <p class="resumen">{B.resumen}</p>
      <p style="margin-top:1rem">
        <a class="enlace-suelto" href={enlace(idioma, 'rss.xml')} style="font-size:.88rem">{B.rss}</a>
      </p>
    </header>

    {articulos.length === 0 && (
      <p style="color:var(--texto-suave)">{B.vacio}</p>
    )}

    {articulos.map((a) => (
      <a class="tarjeta" href={enlace(idioma, `blog/${slugDe(a)}/`)} style="display:block;margin-bottom:1rem;text-decoration:none;color:inherit">
        <div style="display:flex;gap:.8rem;align-items:baseline;flex-wrap:wrap;margin-bottom:.5rem">
          <span class="pastilla-fecha" style="margin:0">{fmt(a.data.fecha)}</span>
          {a.data.minutos && <span style="color:var(--texto-tenue);font-size:.82rem">{B.lectura(a.data.minutos)}</span>}
        </div>
        <h2 style="font-size:1.25rem;margin-bottom:.5rem">{a.data.titulo}</h2>
        <p style="color:var(--texto-suave);font-size:.93rem;margin-bottom:.8rem">{a.data.descripcion}</p>
        <div class="etiquetas">
          {a.data.etiquetas.map((e) => <span class="etiqueta">{e}</span>)}
        </div>
      </a>
    ))}
  </div>
</Base>
