---
/**
 * Un artículo del blog. Ver src/paginas/Portada.astro.
 */
import Base from '../layouts/Base.astro';
import { render } from 'astro:content';
import { perfil } from '../idiomas/contenido.js';
import { t, LOCALE } from '../idiomas/textos.js';
import { enlace } from '../idiomas/rutas.js';
import { articulos, slugDe } from '../idiomas/blog.js';
import { OTRO } from '../idiomas/rutas.js';

const { a, idioma = 'es' } = Astro.props;

// Un artículo puede estar sólo en un idioma. Si no hay gemelo, ni hreflang ni
// enlace roto en el selector: la bandera lleva al índice del otro blog.
const gemelo = (await articulos(OTRO[idioma])).some((x) => slugDe(x) === slugDe(a));
const T = t(idioma);
const B = T.blog;
const { Content } = await render(a);
const fmt = (d) => d.toLocaleDateString(LOCALE[idioma], { day: 'numeric', month: 'long', year: 'numeric' });
const url = new URL(Astro.url.pathname, Astro.site).href;

// Firmar el artículo con la misma entidad Person del sitio: cada texto publicado
// pasa a ser una señal más de autoría a nombre completo.
const esquema = [{
  '@type': 'BlogPosting',
  '@id': `${url}#articulo`,
  headline: a.data.titulo,
  description: a.data.descripcion,
  datePublished: a.data.fecha.toISOString(),
  inLanguage: LOCALE[idioma],
  keywords: a.data.etiquetas,
  mainEntityOfPage: { '@id': `${url}#pagina` },
  author: { '@id': 'https://florintodor.dev/#persona' },
  publisher: { '@id': 'https://florintodor.dev/#persona' },
}];
---

<Base
  idioma={idioma}
  titulo={`${a.data.tituloSeo || a.data.titulo} - Florin Todor`}
  descripcion={a.data.descripcion}
  conLateral={false}
  esquemaExtra={esquema}
  conAlternativas={gemelo}
  alternoFallback="blog/"
>
  <article style="max-width:760px;margin:0 auto">
    <a class="volver" href={enlace(idioma, 'blog/')}>{B.volver}</a>

    <header class="cabecera-proyecto">
      <h1>{a.data.titulo}</h1>
      <div class="meta">
        <span class="etiqueta verde">{fmt(a.data.fecha)}</span>
        {a.data.minutos && <span class="etiqueta">{B.minutos(a.data.minutos)}</span>}
        {a.data.etiquetas.map((e) => <span class="etiqueta">{e}</span>)}
      </div>
      <p class="resumen">{a.data.descripcion}</p>
    </header>

    <div class="prosa">
      <Content />
    </div>

    <hr class="punteado" style="margin:2.5rem 0" />
    <p style="color:var(--texto-suave);font-size:.92rem">
      {B.firma[0]}<strong>Florin Emanuel Todor Gliga</strong>{B.firma[1]}<a href={`mailto:${perfil(idioma).email}`}>{B.firma[2]}</a>{B.firma[3]}
    </p>
  </article>
</Base>
