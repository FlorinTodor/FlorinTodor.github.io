---
// El dashboard de verdad, con datos inventados.
//
// La primera version era un mini-panel escrito aparte, y estaba mal: el
// producto ES un dashboard, asi que ensenar una imitacion no ensenaba nada.
// Ahora se genera el HTML real con tests/dashboard_de_ejemplo.py del propio
// proyecto y se embebe, para que se vea lo que se ve de verdad: las cuatro
// pestanas, las graficas ampliables y las fichas de ejercicio.
import { t } from '../idiomas/textos.js';
import { recurso } from '../idiomas/rutas.js';

const { idioma = 'es' } = Astro.props;
const R = t(idioma).ficha.rutina;
const origen = recurso('demo/rutina-export/');
---

<div class="demo-rutina">
  <p class="dr-aviso">{R.aviso}</p>
  <div class="dr-marco">
    <iframe src={origen} title={R.titulo} loading="lazy"></iframe>
  </div>
  <p class="dr-pie">
    <a href={origen} target="_blank" rel="noopener">{R.abrir}</a>
  </p>
</div>

<style>
  .demo-rutina { margin-top: 4px; }
  .dr-aviso { font-size:.82rem; color:var(--texto-suave); margin:0 0 12px;
              border-left:3px solid var(--borde); padding-left:10px; }
  .dr-marco { border:1px solid var(--borde); border-radius:14px; overflow:hidden;
              background:var(--fondo); }
  .dr-marco iframe { width:100%; height:640px; border:0; display:block; }
  @media (max-width:640px) { .dr-marco iframe { height:520px; } }
  .dr-pie { margin:10px 0 0; font-size:.85rem; }
</style>
