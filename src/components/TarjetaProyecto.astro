---
/**
 * Tarjeta de proyecto de la portada.
 *
 * La tarjeta entera se puede pulsar, pero no es un <a> envolviendo todo: eso
 * impedía meter dentro los enlaces al código y a la memoria, que es lo primero
 * que se echa en falta al mirar la portada. El truco es el enlace del título,
 * que se estira con un ::after hasta cubrir la tarjeta; los enlaces del pie van
 * por encima de esa capa.
 */
import { hayVideo, hayDemo } from '../utilidades/demos.js';

const { p, destacado = false, etiquetas = 3 } = Astro.props;
const base = import.meta.env.BASE_URL;
const video = hayVideo(p.id);
---

<article class={`tarjeta-proyecto ${destacado ? 'destacado' : ''}`}>
  {video && (
    <div class="miniatura">
      <video
        src={`${base}media/${p.id}.mp4`}
        poster={`${base}media/poster/${p.id}.jpg`}
        muted loop playsinline preload="none"></video>
      <span class="insignia-video">▶ demo</span>
    </div>
  )}
  <div class="cuerpo">
    <h3>
      <a class="enlace-tarjeta" href={`${base}proyectos/${p.id}/`}>{p.titulo}</a>
    </h3>
    <p>{p.resumen}</p>
    <div class="pie">
      {p.privado && <span class="etiqueta ambar">Código privado</span>}
      {p.stack.slice(0, etiquetas).map((t) => <span class="etiqueta">{t}</span>)}
    </div>
    <div class="enlaces-tarjeta">
      {/* Los privados ya llevan su etiqueta ámbar en el pie: repetir aquí un
          enlace a la propia tarjeta no aporta nada. */}
      {!p.privado && <a href={p.repo} target="_blank" rel="noopener">Código ↗</a>}
      {p.memoria && (
        <a href={`${base}${p.memoria}`} target="_blank" rel="noopener">Memoria ↗</a>
      )}
      {hayDemo(p.id) && <a href={`${base}proyectos/${p.id}/#demo`}>Demo →</a>}
    </div>
  </div>
</article>
