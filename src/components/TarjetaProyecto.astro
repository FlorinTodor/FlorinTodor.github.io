---
/**
 * Tarjeta de proyecto de la portada.
 *
 * La tarjeta entera se puede pulsar, pero no es un <a> envolviendo todo: eso
 * impedía meter dentro los enlaces al código y a la memoria, que es lo primero
 * que se echa en falta al mirar la portada. El truco es el enlace del título,
 * que se estira con un ::after hasta cubrir la tarjeta; los enlaces del pie van
 * por encima de esa capa.
 */
import { hayVideo, hayDemo } from '../utilidades/demos.js';
import { t } from '../idiomas/textos.js';
import { enlace, recurso } from '../idiomas/rutas.js';

const { p, idioma = 'es', destacado = false, etiquetas = 3 } = Astro.props;
const T = t(idioma).tarjeta;
const video = hayVideo(p.id);
---

<article class={`tarjeta-proyecto ${destacado ? 'destacado' : ''}`}>
  {video && (
    <div class="miniatura">
      <video
        src={recurso(`media/${p.id}.mp4`)}
        poster={recurso(`media/poster/${p.id}.jpg`)}
        muted loop playsinline preload="none"></video>
      <span class="insignia-video">{T.insignia}</span>
    </div>
  )}
  <div class="cuerpo">
    <h3>
      <a class="enlace-tarjeta" href={enlace(idioma, `proyectos/${p.id}/`)}>{p.titulo}</a>
    </h3>
    <p>{p.resumen}</p>
    <div class="pie">
      {p.privado && <span class="etiqueta ambar">{T.privado}</span>}
      {p.stack.slice(0, etiquetas).map((x) => <span class="etiqueta">{x}</span>)}
    </div>
    <div class="enlaces-tarjeta">
      {/* Los privados ya llevan su etiqueta ámbar en el pie: repetir aquí un
          enlace a la propia tarjeta no aporta nada. */}
      {!p.privado && <a href={p.repo} target="_blank" rel="noopener">{T.codigo}</a>}
      {p.memoria && (
        <a href={recurso(p.memoria)} target="_blank" rel="noopener">{T.memoria}</a>
      )}
      {hayDemo(p.id) && <a href={enlace(idioma, `proyectos/${p.id}/#demo`)}>{T.demo}</a>}
    </div>
  </div>
</article>
