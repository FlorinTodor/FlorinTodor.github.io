---
// Reproductor de una sesión del asistente bancario.
// Los gráficos se renderizan de verdad con Chart.js a partir de la misma
// spec que el modelo emite en el proyecto real.
const base = import.meta.env.BASE_URL;
---

<div class="aviso-demo">
  <span aria-hidden="true">ℹ</span>
  <p>
    Sesión grabada, no un modelo en vivo: GitHub Pages es estático y no puede
    ejecutar el backend. Las cifras, el SQL y las herramientas son los reales del
    proyecto; los gráficos se renderizan aquí mismo con Chart.js a partir de la
    misma especificación que emite el modelo.
  </p>
</div>

<div class="demo-banca" data-origen={`${base}demo/sesion-banca.json`}>
  <div class="db-cabecera">
    <div class="db-punto"></div>
    <span id="db-titular">—</span>
    <button class="db-reiniciar" id="db-reiniciar" type="button">Reiniciar</button>
  </div>

  <div class="db-chat" id="db-chat" aria-live="polite"></div>

  <div class="db-sugerencias" id="db-sugerencias"></div>
</div>

<!-- is:global es necesario: las burbujas, llamadas y gráficos los crea el script
     en tiempo de ejecución y no reciben el atributo de scope de Astro, así que
     los estilos con scope no les llegarían. Las clases van prefijadas con db-. -->
<style is:global>
  .demo-banca {
    border: 1px solid var(--borde); border-radius: var(--radio);
    background: var(--bg-elev); overflow: hidden; display: flex; flex-direction: column;
  }
  .db-cabecera {
    display: flex; align-items: center; gap: .55rem;
    padding: .7rem 1rem; border-bottom: 1px solid var(--borde);
    background: var(--bg-sunk); font-size: .87rem; color: var(--texto-suave);
  }
  .db-punto { width: 8px; height: 8px; border-radius: 50%; background: #2eb872; flex-shrink: 0; }
  .db-reiniciar {
    margin-left: auto; font: inherit; font-size: .8rem; cursor: pointer;
    background: none; border: 1px solid var(--borde); color: var(--texto-suave);
    padding: .2rem .6rem; border-radius: 6px;
  }
  .db-reiniciar:hover { color: var(--texto); border-color: var(--borde-fuerte); }

  .db-chat {
    padding: 1rem; display: flex; flex-direction: column; gap: .8rem;
    min-height: 260px; max-height: 520px; overflow-y: auto;
  }
  /* Sin esto los hijos se encogen al desbordar el max-height y aplastan
     la altura fija de los gráficos. */
  .db-chat > * { flex-shrink: 0; }
  .db-burbuja { max-width: 84%; padding: .6rem .85rem; border-radius: 13px; font-size: .91rem; line-height: 1.55; }
  /* Igual que la chapa del grafo: sobre el verde, tinta oscura. */
  .db-burbuja.usuario { align-self: flex-end; background: var(--acento); color: #052616; border-bottom-right-radius: 4px; }
  .db-burbuja.bot { align-self: flex-start; background: var(--bg-sunk); border: 1px solid var(--borde); border-bottom-left-radius: 4px; }
  .db-burbuja strong { font-weight: 650; }

  .db-herramienta {
    align-self: flex-start; max-width: 92%; font-family: var(--mono); font-size: .74rem;
    background: var(--bg-sunk); border: 1px dashed var(--borde-fuerte);
    border-radius: 9px; padding: .5rem .7rem; color: var(--texto-tenue);
  }
  .db-herramienta .nom { color: var(--acento); font-weight: 600; }
  .db-herramienta pre { margin: .35rem 0 0; white-space: pre-wrap; word-break: break-word; font-size: .72rem; }

  .db-lienzo { align-self: stretch; background: var(--bg-sunk); border: 1px solid var(--borde); border-radius: 10px; padding: .8rem; }
  .db-lienzo h5 { margin: 0 0 .5rem; font-size: .8rem; color: var(--texto-suave); font-weight: 600; }
  /* Altura fija: con responsive+maintainAspectRatio el canvas crecería sin tope
     y quedaría recortado por el scroll del chat. El canvas se fuerza a llenar
     el marco porque Chart.js lo mide antes de que termine el scroll del chat. */
  .db-marco-lienzo { position: relative; height: 240px; }
  .db-marco-lienzo.alto { height: 300px; }
  .db-marco-lienzo canvas { position: absolute; inset: 0; width: 100% !important; height: 100% !important; }

  .db-escribiendo { display: flex; gap: 3px; padding: .7rem .9rem; }
  .db-escribiendo i { width: 6px; height: 6px; border-radius: 50%; background: var(--texto-tenue); animation: db-latido 1.1s infinite; }
  .db-escribiendo i:nth-child(2) { animation-delay: .15s; }
  .db-escribiendo i:nth-child(3) { animation-delay: .3s; }
  @keyframes db-latido { 0%, 60%, 100% { opacity: .25; } 30% { opacity: 1; } }

  .db-sugerencias {
    display: flex; flex-wrap: wrap; gap: .45rem;
    padding: .8rem 1rem; border-top: 1px solid var(--borde); background: var(--bg-sunk);
  }
  .db-sugerencias button {
    font: inherit; font-size: .84rem; cursor: pointer;
    background: var(--bg-elev); border: 1px solid var(--borde); color: var(--texto);
    padding: .38rem .75rem; border-radius: 999px;
  }
  .db-sugerencias button:hover:not(:disabled) { border-color: var(--acento); color: var(--acento); }
  .db-sugerencias button:disabled { opacity: .4; cursor: default; }
  .db-sugerencias .listo { color: var(--texto-tenue); font-size: .84rem; align-self: center; }
</style>

<script>
  import Chart from 'chart.js/auto';

  const raiz = document.querySelector('.demo-banca');
  if (raiz) {
    const chat = document.getElementById('db-chat');
    const sugerencias = document.getElementById('db-sugerencias');
    const PALETA = ['#4e79a7', '#f28e2b', '#59a14f', '#e15759', '#b07aa1',
                    '#76b7b2', '#edc948', '#ff9da7', '#9c755f', '#8cd17d', '#bab0ac'];
    let sesion = null, indice = 0, ocupado = false;
    const espera = (ms) => new Promise((r) => setTimeout(r, ms));
    const abajo = () => { chat.scrollTop = chat.scrollHeight; };

    const negritas = (t) =>
      t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');

    function burbuja(texto, quien) {
      const d = document.createElement('div');
      d.className = `db-burbuja ${quien}`;
      d.innerHTML = negritas(texto);
      chat.appendChild(d); abajo();
      return d;
    }

    function llamada(h) {
      const d = document.createElement('div');
      d.className = 'db-herramienta';
      const args = Object.keys(h.args).length ? JSON.stringify(h.args, null, 1) : '{}';
      d.innerHTML = `<span class="nom">▸ ${h.nombre}()</span><pre>${
        args.replace(/</g, '&lt;')}\n← ${String(h.resultado).replace(/</g, '&lt;')}</pre>`;
      chat.appendChild(d); abajo();
    }

    function grafico(spec, titulo) {
      const caja = document.createElement('div');
      caja.className = 'db-lienzo';
      const h = document.createElement('h5');
      h.textContent = titulo;
      const marco = document.createElement('div');
      // El donut necesita más alto: su leyenda lateral lista 11 categorías.
      marco.className = `db-marco-lienzo${spec.type === 'doughnut' ? ' alto' : ''}`;
      const cv = document.createElement('canvas');
      marco.appendChild(cv);
      caja.append(h, marco);
      chat.appendChild(caja); abajo();

      const ds = spec.data.datasets.map((d) => ({
        ...d,
        backgroundColor: spec.type === 'doughnut' ? PALETA : PALETA[0],
        borderRadius: spec.type === 'bar' ? 4 : 0,
        borderWidth: spec.type === 'doughnut' ? 0 : undefined,
      }));
      const oscuro = getComputedStyle(document.body).backgroundColor;
      const tinta = getComputedStyle(document.body).color;

      new Chart(cv, {
        type: spec.type,
        data: { ...spec.data, datasets: ds },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          animation: { duration: 550 },
          plugins: {
            legend: { display: spec.type === 'doughnut', position: 'right',
                      labels: { color: tinta, boxWidth: 11, font: { size: 11 } } },
          },
          scales: spec.type === 'bar' ? {
            x: { ticks: { color: tinta, font: { size: 10 } }, grid: { display: false } },
            y: { ticks: { color: tinta, font: { size: 10 } },
                 grid: { color: 'rgba(128,128,128,.15)' } },
          } : {},
        },
      });
      void oscuro;
    }

    async function pensando(ms) {
      const d = document.createElement('div');
      d.className = 'db-burbuja bot db-escribiendo';
      d.innerHTML = '<i></i><i></i><i></i>';
      chat.appendChild(d); abajo();
      await espera(ms);
      d.remove();
    }

    async function reproducir(i) {
      if (ocupado) return;
      ocupado = true;
      pintarSugerencias();

      const t = sesion.turnos[i];
      burbuja(t.usuario, 'usuario');
      await pensando(520);

      for (const h of t.herramientas) {
        llamada(h);
        await espera(430);
      }
      if (t.herramientas.length) await pensando(420);

      burbuja(t.respuesta, 'bot');
      if (t.grafico) {
        await espera(280);
        grafico(t.grafico, t.grafico.data.datasets[0].label);
      }

      indice = i + 1;
      ocupado = false;
      pintarSugerencias();
    }

    function pintarSugerencias() {
      sugerencias.innerHTML = '';
      if (indice >= sesion.turnos.length) {
        const s = document.createElement('span');
        s.className = 'listo';
        s.textContent = 'Fin de la sesión grabada.';
        sugerencias.appendChild(s);
        return;
      }
      const b = document.createElement('button');
      b.type = 'button';
      b.textContent = sesion.turnos[indice].usuario;
      b.disabled = ocupado;
      b.addEventListener('click', () => reproducir(indice));
      sugerencias.appendChild(b);
    }

    function reiniciar() {
      chat.innerHTML = '';
      indice = 0; ocupado = false;
      burbuja(`Hola 👋 Soy tu asistente. Puedes preguntarme por tu saldo, tus gastos o pedirme que envíe un Bizum.`, 'bot');
      pintarSugerencias();
    }

    fetch(raiz.dataset.origen)
      .then((r) => r.json())
      .then((d) => {
        sesion = d;
        document.getElementById('db-titular').textContent =
          `${d.cuenta.titular} · ${d.cuenta.iban}`;
        document.getElementById('db-reiniciar').addEventListener('click', reiniciar);
        reiniciar();
      })
      .catch(() => {
        raiz.innerHTML = '<p style="padding:1.2rem;color:var(--texto-tenue)">No se pudo cargar la sesión.</p>';
      });
  }
</script>
